# Configuracion del sistema - Plantilla
# Copiar este archivo como .env y completar con los valores reales

# Configuracion de Django
SECRET_KEY=tu-clave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (SQLite en desarrollo, PostgreSQL en produccion)
DATABASE_URL=sqlite:///db.sqlite3

# Zona horaria e idioma
TIME_ZONE=America/Argentina/Buenos_Aires
LANGUAGE_CODE=es-ar

# Email (consola en desarrollo, SMTP en produccion)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-clave-de-aplicacion
DEFAULT_FROM_EMAIL=biblioteca@ejemplo.com
